# ============================================
# Configuration Environnement
# ============================================
# ⚠️  Copier ce fichier vers .env et adapter les valeurs

# Base PostgreSQL
# Dans les containers, DATABASE_URL est forcée par docker-compose.yml (hôte "postgres").
# Depuis la machine hôte (client SQL) : localhost:5435
DATABASE_URL=postgresql://painavance:painavance@localhost:5435/painavance

# Payload — générer avec : openssl rand -hex 32
PAYLOAD_SECRET=change-me

# URL publique de l'app, lue à l'exécution (liens des e-mails, redirections Stripe Checkout)
SERVER_URL=http://localhost:3000

# Prestataire de paiement : "stripe" (défaut) ou "simulated" (page de paiement factice).
# "simulated" est refusé en production, sauf serveur de test déclaré ci-dessous (bandeau affiché).
PAYMENT_PROVIDER=stripe
ALLOW_SIMULATED_PAYMENT_IN_PRODUCTION=false

# Stripe — MODE TEST uniquement en dev (clés sk_test_ / pk_test_)
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Donné par la Stripe CLI (podman compose --profile stripe up, puis logs du service stripe)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# E-mails (SMTP). En dev, docker-compose.yml force SMTP_HOST=mailpit (interface http://localhost:8026).
# En production : SMTP du prestataire (Brevo, Resend…). Sans SMTP_HOST, les e-mails sont écrits dans les logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=commandes@example.fr
EMAIL_FROM_NAME=Un pain d'avance
