# ============================================
# Configuration Environnement
# ============================================
# ⚠️  Copier ce fichier vers .env et adapter les valeurs

# Base PostgreSQL
# Dans les containers, DATABASE_URL est forcée par docker-compose.yml (hôte "postgres").
# Depuis la machine hôte (client SQL) : localhost:5435
DATABASE_URL=postgresql://painavance:painavance@localhost:5435/painavance

# Payload — générer avec : openssl rand -hex 32
PAYLOAD_SECRET=change-me

# URL publique de l'app (redirections Stripe Checkout, emails)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Stripe — MODE TEST uniquement en dev (clés sk_test_ / pk_test_)
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Donné par la Stripe CLI (podman compose --profile stripe up, puis logs du service stripe)
STRIPE_WEBHOOK_SECRET=whsec_xxx
