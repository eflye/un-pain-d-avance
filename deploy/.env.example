# ============================================
# Configuration serveur - Un pain d'avance
# ============================================
# Copier vers deploy/.env sur le serveur. Ne jamais committer ce fichier.

# Version de l'image (tag de release sans le « v », ex. 0.1.0) ; « latest » = dernière release
APP_VERSION=latest
# Adresse et port d'écoute de l'app sur le serveur (le reverse proxy relaie vers ce port)
APP_BIND=127.0.0.1
APP_PORT=3000

# Base de données — mot de passe : openssl rand -hex 24 (hexadécimal : pas d'échappement dans l'URL)
POSTGRES_DB=painavance
POSTGRES_USER=painavance
POSTGRES_PASSWORD=

# Payload — générer avec : openssl rand -hex 32
PAYLOAD_SECRET=

# URL publique du site (liens des e-mails, redirections de paiement), sans « / » final
SERVER_URL=https://precommande.exemple.fr

# Paiement : "stripe" (production) ou "simulated" (serveur de test sans clés Stripe)
PAYMENT_PROVIDER=simulated
# Serveur de test uniquement : autorise "simulated" en production et affiche le bandeau « Site de test ».
# À passer à false (ou supprimer) sur le site réel.
ALLOW_SIMULATED_PAYMENT_IN_PRODUCTION=true

# Stripe (quand PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mails (SMTP du prestataire : Brevo, Resend…). Vide = e-mails écrits dans les logs de l'app.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=commandes@example.fr
EMAIL_FROM_NAME=La Mie Deininge
