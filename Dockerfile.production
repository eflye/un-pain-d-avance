# Image de production : Next.js standalone + Payload.
#   podman build -f Dockerfile.production -t un-pain-d-avance .
# Construite et publiée sur ghcr.io à chaque release GitHub (.github/workflows/release.yml).
# Au démarrage (NODE_ENV=production), Payload applique les migrations de src/migrations.

FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat

# Dépendances, installées depuis le lockfile uniquement
FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci --no-audit --no-fund

# Build
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
# Valeurs factices : la config Payload est chargée au build mais aucune base n'y est contactée.
# Les vraies valeurs sont fournies à l'exécution.
RUN PAYLOAD_SECRET=build-only DATABASE_URL=postgresql://build:build@localhost:5432/build \
    npm run build

# Exécution
FROM base AS runner
WORKDIR /app
ARG VERSION=dev
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    MEDIA_DIR=/app/media \
    APP_VERSION=${VERSION}
LABEL org.opencontainers.image.title="un-pain-d-avance" \
      org.opencontainers.image.description="Précommande de boulangerie en tournée (Next.js + Payload)" \
      org.opencontainers.image.source="https://github.com/eflye/un-pain-d-avance" \
      org.opencontainers.image.version="${VERSION}"

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
# Photos produits : volume persistant
RUN mkdir -p /app/media && chown nextjs:nodejs /app/media
VOLUME ["/app/media"]

USER nextjs
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/api/health || exit 1
CMD ["node", "server.js"]
